# Port des Webservers (Standard: 3100)
PORT=3100

# Netzwerk-Interface (0.0.0.0 = auch aus dem Heimnetz erreichbar)
HOST=0.0.0.0

# Zeitzone des Servers – muss zur Zeitzone des Pi passen
TZ=Europe/Zurich

# Name des Kindes (wird beim ersten Start in die config.json uebernommen)
CHILD_NAME=Aris

# Anzeigeformat
LOCALE=de-CH
TIMEZONE=Europe/Zurich

# Optional: anderer Pfad fuer die Konfigurationsdatei
# CONFIG_FILE=/home/pi/aris-stundenplan/config.json
